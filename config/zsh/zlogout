if which wsh > /dev/null 2>&1; then
    if [[ -z "$SSH_CONNECTION" && "$SHLVL" -eq 1 ]]; then
        # exit the wsh block if it is the local shell
        wsh deleteblock
    fi
fi

# backup hist file.
if which backup_hist.py > /dev/null 2>&1; then
    backup_hist.py
fi

[ -f $HOME/.zsh/zlogout.mine ] && source $HOME/.zsh/zlogout.mine

